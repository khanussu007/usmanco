{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "admin.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/admin(.*)",
      "destination": "/admin.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.js"
    }
  ]
}
